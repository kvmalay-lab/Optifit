# FitFlex Arena — Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8765

# Database (default: local SQLite)
DATABASE_URL=sqlite:///./fitflex.db
# For PostgreSQL: postgresql://user:password@host:5432/fitflex

# CORS — comma-separated allowed origins (* for dev)
ALLOWED_ORIGINS=*
